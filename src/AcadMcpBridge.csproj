<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AutoCAD MCP Bridge: an in-process AutoCAD plugin that serves a small JSON
    HTTP API on localhost. The Python MCP server (server\acad_mcp_server.py)
    talks to it. Independent of the Navisworks MCP bridge (different names,
    port, bundle).

    One build per AutoCAD series:
      dotnet build -c Release -p:AcadSeries=R25   -> AutoCAD 2025-2026 (.NET 8)
      dotnet build -c Release -p:AcadSeries=R26   -> AutoCAD 2027      (.NET 10)
  -->
  <PropertyGroup>
    <AcadSeries Condition="'$(AcadSeries)' == ''">R25</AcadSeries>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AcadSeries)' == 'R25'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- 25.0.1 is the last net8.0 package; later 2025/2026 updates (25.0.2, 25.1.1, Aug-Sep 2026) moved
         AutoCAD to .NET 10, and a net8.0 build runs on both runtimes. -->
    <AcadNetVersion>25.0.1</AcadNetVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AcadSeries)' == 'R26'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <AcadNetVersion>26.0.0</AcadNetVersion>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>AcadMcpBridge</AssemblyName>
    <RootNamespace>AcadMcpBridge</RootNamespace>
    <Version>0.4.2</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);ACAD_$(AcadSeries)</DefineConstants>
    <OutputPath>..\bin\$(Configuration)\$(AcadSeries)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against AutoCAD's managed API; never ship AutoCAD's DLLs. -->
    <PackageReference Include="AutoCAD.NET" Version="$(AcadNetVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ribbon icons (tools\Make-Icons.ps1), loaded by name: McpStart_32.png etc. -->
    <EmbeddedResource Include="Resources\*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF drops System.IO from the implicit usings (System.Windows.Shapes.Path clash). -->
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
